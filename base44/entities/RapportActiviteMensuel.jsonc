{
  "name": "RapportActiviteMensuel",
  "type": "object",
  "properties": {
    "centre_id": {
      "type": "string",
      "description": "ID du centre de sant\u00e9"
    },
    "centre_nom": {
      "type": "string"
    },
    "mois": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "annee": {
      "type": "integer"
    },
    "date_generation": {
      "type": "string",
      "format": "date-time"
    },
    "statistiques": {
      "type": "object",
      "properties": {
        "nombre_rdv_total": {
          "type": "integer",
          "default": 0
        },
        "nombre_rdv_realises": {
          "type": "integer",
          "default": 0
        },
        "nombre_rdv_annules": {
          "type": "integer",
          "default": 0
        },
        "nombre_rdv_no_show": {
          "type": "integer",
          "default": 0
        },
        "taux_realisation_percent": {
          "type": "number",
          "default": 0
        },
        "nombre_patients_uniques": {
          "type": "integer",
          "default": 0
        },
        "nombre_nouveaux_patients": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "consultation_par_type": {
      "type": "object",
      "description": "D\u00e9tail par type de consultation",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "consultation_par_professionnel": {
      "type": "object",
      "description": "D\u00e9tail par professionnel",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "integer"
          },
          "taux_satisfaction": {
            "type": "number"
          }
        }
      }
    },
    "financier": {
      "type": "object",
      "properties": {
        "montant_total_facture": {
          "type": "number",
          "default": 0
        },
        "montant_paye": {
          "type": "number",
          "default": 0
        },
        "montant_impaye": {
          "type": "number",
          "default": 0
        },
        "taux_recouvrement_percent": {
          "type": "number",
          "default": 0
        },
        "montant_moyen_par_rdv": {
          "type": "number",
          "default": 0
        },
        "nombre_factures_generees": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "taux_satisfaction_moyen": {
          "type": "number",
          "default": 0
        },
        "temps_moyen_rdv_minutes": {
          "type": "number",
          "default": 0
        },
        "nombre_documents_generes": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "observations": {
      "type": "string",
      "description": "Observations et recommandations admin"
    },
    "fichier_pdf_url": {
      "type": "string",
      "description": "URL du rapport PDF g\u00e9n\u00e9r\u00e9"
    },
    "statut_generation": {
      "type": "string",
      "enum": [
        "en_attente",
        "en_cours",
        "termine",
        "erreur"
      ],
      "default": "en_attente"
    }
  },
  "required": [
    "centre_id",
    "centre_nom",
    "mois",
    "annee"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}