{
  "name": "SignalWebRTC",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "ID unique de la session vid\u00e9o (ex: rdv_123)"
    },
    "sender_email": {
      "type": "string",
      "format": "email"
    },
    "receiver_email": {
      "type": "string",
      "format": "email"
    },
    "type": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "ice-candidate",
        "join",
        "leave",
        "call-ended"
      ],
      "description": "Type de signal WebRTC"
    },
    "payload": {
      "type": "string",
      "description": "Donn\u00e9es JSON stringifi\u00e9es (SDP ou ICE candidate)"
    },
    "processed": {
      "type": "boolean",
      "default": false
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "room_id",
    "sender_email",
    "type"
  ]
}